{{> header}}

<div id="contents">
	<div class="box">
		<div>
			<div class="body">
				<h1>Travel</h1>

				<ul id="sites">
					{{#each trips}}
					<li>
						<a href="/api/trips/{{this.code}}">
							<img src="/images/{{this.image}}" alt="Img">
						</a>

						<h2>
							<a href="/travel">{{this.name}}</a>
						</h2>

						<p>{{this.description}}</p>

						<p>
							Length: {{this.length}}<br>
							Resort: {{this.resort}}<br>
							Price: {{this.perPerson}}
						</p>
					</li>
					{{/each}}
				</ul>

			</div>
		</div>
	</div>
</div>

{{> footer}}